# Docker Compose 本地部署凭证示例。
# 复制为 .env.compose.local 后，替换所有 REPLACE_ME 值，再执行：
# docker compose --env-file .env.compose.local up -d
# .env.compose.local 已被 Git 忽略，禁止提交真实凭证。

FASTGPT_ROOT_PASSWORD=REPLACE_ME_FASTGPT_ROOT_PASSWORD
FASTGPT_SYSTEM_KEY=REPLACE_ME_FASTGPT_SYSTEM_KEY
FASTGPT_PLUGIN_AUTH_TOKEN=REPLACE_ME_FASTGPT_PLUGIN_AUTH_TOKEN
FASTGPT_CODE_SANDBOX_TOKEN=REPLACE_ME_FASTGPT_CODE_SANDBOX_TOKEN
FASTGPT_AGENT_SANDBOX_PROXY_SECRET=REPLACE_ME_FASTGPT_AGENT_SANDBOX_PROXY_SECRET_32_CHARS_MIN
FASTGPT_VOLUME_MANAGER_AUTH_TOKEN=REPLACE_ME_FASTGPT_VOLUME_MANAGER_AUTH_TOKEN
FASTGPT_AIPROXY_ADMIN_KEY=REPLACE_ME_FASTGPT_AIPROXY_ADMIN_KEY

MONGODB_USER=REPLACE_ME_MONGODB_USER
MONGODB_PASSWORD=REPLACE_ME_MONGODB_PASSWORD
REDIS_USER=REPLACE_ME_REDIS_USER
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

STORAGE_ACCESS_KEY_ID=REPLACE_ME_STORAGE_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME_STORAGE_SECRET_ACCESS_KEY

OPENSANDBOX_API_KEY=REPLACE_ME_OPENSANDBOX_API_KEY

VECTOR_DB_USER=REPLACE_ME_VECTOR_DB_USER
VECTOR_DB_PASSWORD=REPLACE_ME_VECTOR_DB_PASSWORD

FASTGPT_FILE_TOKEN_KEY=REPLACE_ME_FASTGPT_FILE_TOKEN_KEY
FASTGPT_AES256_SECRET_KEY=REPLACE_ME_FASTGPT_AES256_SECRET_KEY
FASTGPT_INVOKE_TOKEN_SECRET=REPLACE_ME_FASTGPT_INVOKE_TOKEN_SECRET

AIPROXY_DB_USER=REPLACE_ME_AIPROXY_DB_USER
AIPROXY_DB_PASSWORD=REPLACE_ME_AIPROXY_DB_PASSWORD
