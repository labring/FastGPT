{
  "name": "@fastgpt/cli",
  "version": "0.1.0-beta.3",
  "description": "Official CLI for FastGPT",
  "type": "module",
  "main": "./dist/run.mjs",
  "bin": {
    "fastgpt": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/run.mjs"
    },
    "./run": {
      "import": "./dist/run.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labring/FastGPT.git",
    "directory": "cli"
  },
  "homepage": "https://doc.fastgpt.cn",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build:tsdown": "tsdown --config ./scripts/build.tsdown.ts && chmod +x dist/cli.mjs",
    "build:bun": "bun ./scripts/build.bun.ts --bundle-only",
    "compile": "bun ./scripts/build.bun.ts",
    "test": "vitest run --config ./vitest.config.ts",
    "test:bin": "pnpm build:tsdown && node test/bin-smoke.mjs",
    "test:ci": "pnpm typecheck && pnpm test && pnpm test:bin",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src ./test"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@fastgpt/global": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "commander": "catalog:",
    "ky": "catalog:",
    "picocolors": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
