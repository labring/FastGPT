{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./.tsc-out",
    "tsBuildInfoFile": "./.tsc-out/tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../global/tsconfig.composite.json" }
  ],
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/test/**", "**/*.test.ts", "vitest*.config.ts", "dist", "coverage", ".tsc-out"]
}
