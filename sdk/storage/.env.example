# Integration tests are opt-in. Copy the required provider block to .env.test.local.
# BUCKET must start with fastgpt-sdk-. Its existing contents are deleted before every suite.

# Opt-in Multipart benchmark. It only uses STORAGE_PRIVATE_BUCKET by default and cleans its test keys.
STORAGE_MULTIPART_BENCHMARK_ENV_FILE=
STORAGE_MULTIPART_BENCHMARK_BUCKET=
STORAGE_MULTIPART_BENCHMARK_SIZE_BYTES=33554432
STORAGE_MULTIPART_BENCHMARK_PART_SIZE_BYTES=8388608
STORAGE_MULTIPART_BENCHMARK_CONCURRENCY=3
STORAGE_MULTIPART_BENCHMARK_MAX_RETRY=3
STORAGE_MULTIPART_BENCHMARK_RETRY_BASE_DELAY_MS=300
STORAGE_MULTIPART_BENCHMARK_ROUNDS=1
STORAGE_MULTIPART_BENCHMARK_MAX_DURATION_MS=900000
STORAGE_MULTIPART_BENCHMARK_ABORT_PROBE=true

# Local MinIO
STORAGE_TEST_MINIO_ENABLED=false
STORAGE_TEST_MINIO_ENDPOINT=http://127.0.0.1:9000
STORAGE_TEST_MINIO_REGION=us-east-1
STORAGE_TEST_MINIO_ACCESS_KEY_ID=minioadmin
STORAGE_TEST_MINIO_SECRET_ACCESS_KEY=minioadmin
STORAGE_TEST_MINIO_PRIVATE_BUCKET=fastgpt-sdk.integration-bucket-1-private
STORAGE_TEST_MINIO_PUBLIC_BUCKET=fastgpt-sdk.integration-bucket-1-public
STORAGE_TEST_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# AWS S3 or another S3-compatible endpoint
STORAGE_TEST_AWS_S3_ENABLED=false
STORAGE_TEST_AWS_S3_ENDPOINT=https://s3.amazonaws.com
STORAGE_TEST_AWS_S3_REGION=us-east-1
STORAGE_TEST_AWS_S3_ACCESS_KEY_ID=
STORAGE_TEST_AWS_S3_SECRET_ACCESS_KEY=
STORAGE_TEST_AWS_S3_FORCE_PATH_STYLE=false
STORAGE_TEST_AWS_S3_PRIVATE_BUCKET=
STORAGE_TEST_AWS_S3_PUBLIC_BUCKET=
STORAGE_TEST_AWS_S3_PUBLIC_ENDPOINT=

# Cloudflare R2
STORAGE_TEST_R2_ENABLED=false
STORAGE_TEST_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_TEST_R2_REGION=auto
STORAGE_TEST_R2_ACCESS_KEY_ID=
STORAGE_TEST_R2_SECRET_ACCESS_KEY=
STORAGE_TEST_R2_PUBLIC_BUCKET=
STORAGE_TEST_R2_PRIVATE_BUCKET=
STORAGE_TEST_R2_PUBLIC_ENDPOINT=

# Alibaba Cloud OSS
STORAGE_TEST_OSS_ENABLED=false
STORAGE_TEST_OSS_ENDPOINT=
STORAGE_TEST_OSS_REGION=
STORAGE_TEST_OSS_ACCESS_KEY_ID=
STORAGE_TEST_OSS_SECRET_ACCESS_KEY=
STORAGE_TEST_OSS_PUBLIC_BUCKET=
STORAGE_TEST_OSS_PRIVATE_BUCKET=
STORAGE_TEST_OSS_PUBLIC_ENDPOINT=

# Tencent Cloud COS
STORAGE_TEST_COS_ENABLED=false
# Full COS bucket name; it must end with -<STORAGE_TEST_COS_APP_ID>.
STORAGE_TEST_COS_REGION=
STORAGE_TEST_COS_APP_ID=
STORAGE_TEST_COS_ACCESS_KEY_ID=
STORAGE_TEST_COS_SECRET_ACCESS_KEY=
STORAGE_TEST_COS_PRIVATE_BUCKET=
STORAGE_TEST_COS_PUBLIC_BUCKET=
STORAGE_TEST_COS_PUBLIC_ENDPOINT=
