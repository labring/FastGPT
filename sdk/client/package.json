{
  "name": "@fastgpt/sdk",
  "private": false,
  "version": "0.1.0-beta.1",
  "description": "Official TypeScript/JavaScript SDK for FastGPT OpenAPI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./sse": {
      "import": {
        "types": "./dist/sse.d.mts",
        "default": "./dist/sse.mjs"
      },
      "require": {
        "types": "./dist/sse.d.cts",
        "default": "./dist/sse.cjs"
      }
    },
    "./options": {
      "import": {
        "types": "./dist/options.d.mts",
        "default": "./dist/options.mjs"
      },
      "require": {
        "types": "./dist/options.d.cts",
        "default": "./dist/options.cjs"
      }
    },
    "./interactive": {
      "import": {
        "types": "./dist/interactive.d.mts",
        "default": "./dist/interactive.mjs"
      },
      "require": {
        "types": "./dist/interactive.d.cts",
        "default": "./dist/interactive.cjs"
      }
    },
    "./pagination": {
      "import": {
        "types": "./dist/pagination.d.mts",
        "default": "./dist/pagination.mjs"
      },
      "require": {
        "types": "./dist/pagination.d.cts",
        "default": "./dist/pagination.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "FastGPT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labring/FastGPT.git",
    "directory": "sdk/client"
  },
  "homepage": "https://doc.fastgpt.cn",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:smoke": "vitest run --config vitest.config.ts test/integration.smoke.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
