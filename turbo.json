{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:pro": {
      "with": ["@fastgpt/admin#dev"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "worker/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "env": [
        "FASTGPT_TEST_OCEANBASE_URI",
        "FASTGPT_TEST_REQUIRED_OCEANBASE",
        "FASTGPT_TEST_REQUIRE_PRO_SCHEMA_GUARD"
      ],
      "passThroughEnv": [
        "CI",
        "FASTGPT_TEST_MONGODB_URI",
        "FASTGPT_TEST_MAX_WORKERS",
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_DOWNLOAD_DIR"
      ],
      "outputs": ["coverage/**", "test-results.json"]
    },
    "@fastgpt/dal#test": {
      "cache": false,
      "env": [
        "FASTGPT_TEST_OCEANBASE_URI",
        "FASTGPT_TEST_REQUIRED_OCEANBASE",
        "FASTGPT_TEST_REQUIRE_PRO_SCHEMA_GUARD"
      ],
      "passThroughEnv": [
        "CI",
        "FASTGPT_TEST_MONGODB_URI",
        "FASTGPT_TEST_MAX_WORKERS",
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_DOWNLOAD_DIR"
      ],
      "outputs": ["coverage/**", "test-results.json"]
    },
    "test:integration": {
      "cache": false,
      "outputs": ["test-results.integration.json"]
    },
    "typecheck": {
      "outputs": []
    },
    "build:workers": {
      "cache": false,
      "outputs": ["worker/**"]
    }
  }
}
