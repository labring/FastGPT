flowchart TB
  A["输入：历史上下文 / Tool Response / 大文本"] --> B{"识别压缩场景"}

  subgraph P["三类压缩路径"]
  direction LR

  subgraph H["历史上下文 checkpoint"]
    direction TB
    H1{"messages + tools<br/>是否超过上下文 80%"}
    H2["原样返回"]
    H3["保留 system / developer<br/>序列化 active plan"]
    H4["绑定 tool_calls 与 tool results<br/>提取目标、约束和精确锚点"]
    H5["LLM 生成隐藏的<br/>context_checkpoint"]
  end

  subgraph T["Tool Response"]
    direction TB
    T1{"响应是否超过上下文 20%"}
    T2["原样返回"]
    T3["本地轻量压缩<br/>JSON minify / 结构摘要 / 文本清理"]
    T4{"处理后是否超过上下文 50%"}
  end

  subgraph L["通用大文本压缩"]
    direction TB
    L1["真实 tokenizer 计算 token 预算"]
    L2["规则清理<br/>URL / Base64 / 图片 / 路径 / ID / 空白"]
    L3{"是否仍然超预算"}
    L4["分块并行 LLM 压缩<br/>按总预算分配每块输出"]
    L5["合并并重新计算 token<br/>最多两轮合并压缩"]
    L6["仍超限：head-tail 截断<br/>过短：补原文摘录和精确锚点"]
  end

  end

  Z["输出：更短且可继续执行的上下文"]

  B -->|"checkpoint_history"| H1
  H1 -->|"否"| H2 --> Z
  H1 -->|"是"| H3 --> H4 --> H5 --> Z

  B -->|"tool_response"| T1
  T1 -->|"否"| T2 --> Z
  T1 -->|"是"| T3 --> T4
  T4 -->|"否"| Z
  T4 -->|"是，目标压回约 20%"| L1

  B -->|"large_content"| L1
  L1 --> L2 --> L3
  L3 -->|"否"| Z
  L3 -->|"是"| L4 --> L5 --> L6 --> Z

  classDef input fill:#1f2937,color:#ffffff,stroke:#111827,stroke-width:2px;
  classDef decision fill:#fff7d6,color:#3f3210,stroke:#d6a700,stroke-width:2px;
  classDef local fill:#e8f3ff,color:#173b5f,stroke:#4d8fc9,stroke-width:1.5px;
  classDef llm fill:#f3e8ff,color:#4b256d,stroke:#9560bd,stroke-width:1.5px;
  classDef output fill:#e6f7ed,color:#174b2b,stroke:#3a9b62,stroke-width:2px;

  class A input;
  class B,H1,T1,T4,L3 decision;
  class H2,H3,H4,T2,T3,L1,L2 local;
  class H5,L4,L5,L6 llm;
  class Z output;
