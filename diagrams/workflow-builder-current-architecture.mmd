%% 当前 Workflow Builder 实际架构
graph LR
    U[用户] --> UI[Workflow Builder 聊天窗口]
    UI --> R[Pro Workflow Builder Runner]

    R --> L[Agent Loop Core<br/>主 Agent + AgentPlan]
    R --> S[研究 Sandbox<br/>Skill / 文档 / 用户文件]
    L --> Q[workflow_cli_query<br/>只读查询]
    L --> A[workflow_cli_apply<br/>ChangeSet 提交]

    Q --> G[CLI Gateway<br/>白名单 / 参数校验 / 重试计数]
    A --> G
    G --> T[事务 Sandbox<br/>隔离的 workflow.json + CLI]
    T --> C[Workflow CLI<br/>changeset plan / apply]
    C --> W[Workflow Core<br/>Schema / Command / Validation]

    W --> P[WorkflowPlan<br/>目标文档 / checksum / diagnostics]
    P --> G
    G --> V[服务端语义审查<br/>无工具 Agent 回合]
    V --> X{审查通过?}
    X -->|否| L
    X -->|是| D[ApplyWorkflowPlan<br/>再次校验并原子应用]
    D --> CANVAS[WorkflowDocument<br/>映射到实际画布 / 保存]
    CANVAS --> F[最终无工具 Agent 回合<br/>向用户报告完成或失败]
    F --> UI

    classDef user fill:#e8f1ff,stroke:#2f7df6,color:#102a56;
    classDef agent fill:#fff4dc,stroke:#d88a00,color:#4d3000;
    classDef boundary fill:#e9f8ef,stroke:#2f9e5b,color:#123d24;
    classDef core fill:#f1eaff,stroke:#845ef7,color:#29134d;
    classDef output fill:#e8faf8,stroke:#12a594,color:#073d38;

    class U,UI user;
    class R,L,S,Q,A,V,F agent;
    class G,T,C boundary;
    class W,P core;
    class D,CANVAS,X output;
