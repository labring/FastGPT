# Marketplace 服务自身的环境变量，不由 FastGPT 后台表单管理。
# 可选项默认保持注释；切换存储供应商时，修改下方现有参数并填写对应分组。

# ===== 鉴权 =====
AUTH_TOKEN=xxxx
COMMUNITY_AUTH_TOKEN=xxxx

# ===== MongoDB =====
MONGODB_URI="mongodb://myusername:mypassword@localhost:27017/fastgpt?authSource=admin&directConnection=true"
# 连接池上限及同时建连数；ENV 默认 20，实际按 max(30, DB_MAX_LINK) 使用。
# DB_MAX_LINK=20

# ===== 对象存储：通用配置 =====
# 支持 minio、aws-s3、r2、cos、oss；以下保留 MinIO 示例。
STORAGE_VENDOR=minio
STORAGE_PUBLIC_BUCKET=fastgpt-plugins
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# 默认 us-east-1；COS、OSS 应填写对应供应商的地域。
# STORAGE_REGION=us-east-1

# ===== MinIO / AWS S3 / R2 =====
STORAGE_S3_ENDPOINT=http://localhost:9000
# 仅 MinIO / AWS S3 使用：供外部访问的端点。
STORAGE_EXTERNAL_ENDPOINT=http://localhost:9000
# 仅 MinIO / AWS S3 使用：代码默认 false，MinIO 示例设为 true；R2 固定为 false。
STORAGE_S3_FORCE_PATH_STYLE=true
# 最大重试次数，默认 3。
# STORAGE_S3_MAX_RETRIES=3
# 可选：公开访问 URL 的额外子路径，未设置时不添加。
# STORAGE_PUBLIC_ACCESS_EXTRA_SUB_PATH=
# 仅 R2 使用：公开访问域名，填写完整 URL。
# STORAGE_R2_PUBLIC_ENDPOINT=https://files.example.com

# ===== 腾讯云 COS（STORAGE_VENDOR=cos） =====
# 协议仅支持 https: 或 http:，默认 https:。
# STORAGE_COS_PROTOCOL=https:
# 是否使用全球加速，默认 false。
# STORAGE_COS_USE_ACCELERATE=false
# 可选：自定义域名与代理地址，默认均未设置。
# STORAGE_COS_CNAME_DOMAIN=
# STORAGE_COS_PROXY=

# ===== 阿里云 OSS（STORAGE_VENDOR=oss） =====
# 可选：自定义端点，未设置时由 SDK 按地域选择。
# STORAGE_OSS_ENDPOINT=
# 是否使用自定义域名，默认 false。
# STORAGE_OSS_CNAME=false
# 是否走内网端点，默认 false。
# STORAGE_OSS_INTERNAL=false
# 是否使用 HTTPS，Marketplace 的 ENV 默认 false；需要 HTTPS 时设为 true。
# STORAGE_OSS_SECURE=false

# ===== 日志 =====
# 是否输出控制台日志，默认 true。
# LOG_ENABLE_CONSOLE=true
# 支持 trace、debug、info、warning、error、fatal；默认 debug。
# LOG_CONSOLE_LEVEL=debug
# 是否启用 OpenTelemetry 日志上报，默认 false。
# LOG_ENABLE_OTEL=false
# 上报日志级别，默认 info，取值范围同 LOG_CONSOLE_LEVEL。
# LOG_OTEL_LEVEL=info
# 日志服务名，默认 fastgpt-marketplace。
# LOG_OTEL_SERVICE_NAME=fastgpt-marketplace
# 可选：logger 名称，未设置时使用服务名。
# LOG_OTEL_LOGGER_NAME=
# OTLP HTTP 日志接收地址；启用上报且未设置时使用以下默认值。
# LOG_OTEL_URL=http://localhost:4318/v1/logs
