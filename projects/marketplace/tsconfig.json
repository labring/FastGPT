{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "tailwind.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../packages/web/i18n/i18next.ts",
    "../../packages/global/**/*.d.ts",
    "../../packages/service/**/*.d.ts",
    "../../packages/web/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "test/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest*.config.ts",
    "../../packages/**/vitest*.config.ts",
    "../../packages/**/tsdown.config.ts",
    "../../packages/**/test/**",
    "../../packages/**/dist/**",
    "../../packages/**/.tsc-out/**",
    "../../packages/workflow-core/**",
    ".next",
    "dist",
    "coverage",
    ".tsc-out"
  ]
}
