# 主监听端口：默认同时提供 /health、/terminal（WebSocket）和 /preview/:sessionId/*（HTTP）
PORT=1006

# 可选独立预览端口：仅在网关/WAF 限制单端口混用 WS 与 HTTP 时配置；启用后 PORT 仅暴露 /terminal，PREVIEW_PORT 仅暴露 /preview/*
PREVIEW_PORT=

# 与 fastgpt-app 共享的内部鉴权密钥（必填，须与主站 AGENT_SANDBOX_PROXY_SECRET 一致）
AGENT_SANDBOX_PROXY_SECRET=

# fastgpt-app 内网访问基地址（必填，用于调用 /api/core/ai/sandbox/verifyTicket 与 /api/core/ai/sandbox/keepalive）
FASTGPT_APP_URL=http://localhost:3000

# 可选：Docker 本地开发场景下若 verifyTicket 返回 localhost/127.0.0.1，可重写为 host.docker.internal
AGENT_SANDBOX_PROXY_REWRITE_HOST=
