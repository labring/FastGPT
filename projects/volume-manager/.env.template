# 服务监听端口
PORT=3000
# 复制为 .env 后修改

# 鉴权 Token（必填），FastGPT 侧对应 AGENT_SANDBOX_OPENSANDBOX_VOLUME_MANAGER_TOKEN
VM_AUTH_TOKEN=changeme

# 运行时类型：docker（默认，JuiceFS --subdir FUSE + Docker local bind 卷）或 kubernetes（k8s JuiceFS CSI PVC）
VM_RUNTIME=docker

# JuiceFS 独立元数据库与对象存储配置：
# - docker 模式下 VM_JUICEFS_META_URL 必填（支持 postgres/mysql/OceanBase/redis/tikv/sqlite3；SQL 引擎未显式指定时默认追加 max_open_conns=4&max_idle_conns=1&max_idle_time=60）
# - 默认内置 minio / fastgpt-sandbox-rustfs 必填静态 ACCESS_KEY 与 SECRET_KEY；外接云对象存储（s3/oss/cos/obs/tos 等）可成对配置静态 AK/SK，或同时留空以复用云主机 IAM Role / RAM 角色凭证
VM_JUICEFS_META_URL=postgres://postgres:password@fastgpt-sandbox-pg:5432/juicefs?sslmode=disable
VM_JUICEFS_STORAGE=minio
VM_JUICEFS_BUCKET=http://fastgpt-sandbox-rustfs:9000/fastgpt-sandbox
VM_JUICEFS_ACCESS_KEY=rustfsadmin
VM_JUICEFS_SECRET_KEY=rustfsadmin

# k8s 命名空间与 JuiceFS CSI StorageClass 名称（kubernetes 模式下均必填，不支持回退）
# VM_K8S_NAMESPACE=fgc
# VM_K8S_PVC_STORAGE_CLASS=juicefs-sc

# 日志配置
LOG_ENABLE_CONSOLE=true
LOG_CONSOLE_LEVEL=info
LOG_ENABLE_OTEL=false
LOG_OTEL_SERVICE_NAME=fastgpt-volume-manager
# LOG_OTEL_URL=http://localhost:4318/v1/logs
