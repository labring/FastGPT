# 服务监听端口
PORT=3000
# 复制为 .env 后修改

# 独立 Volume Manager 服务的鉴权 Token（必填）。
# FastGPT 侧在后台 /admin/subservice/agent-sandbox 的 OpenSandbox 配置中填写相同的 Volume Manager Token，
# 对应实例字段 subservice.agentSandbox.opensandbox.volumeManagerToken；主站不再使用 AGENT_SANDBOX_VOLUME_MANAGER_TOKEN ENV。
VM_AUTH_TOKEN=changeme

# 运行时类型：docker（Docker named volume）或 kubernetes（k8s PVC）
VM_RUNTIME=docker

# Docker socket 路径（仅 docker 模式）
VM_DOCKER_SOCKET=/var/run/docker.sock
VM_DOCKER_API_VERSION=v1.44

# k8s 命名空间（仅 kubernetes 模式）
VM_K8S_NAMESPACE=opensandbox
# k8s StorageClass 名称（仅 kubernetes 模式）
VM_K8S_PVC_STORAGE_CLASS=standard

# 日志配置：统一使用 @fastgpt-sdk/otel/logger（默认开启控制台 info 级别日志）
# LOG_ENABLE_CONSOLE=true
# LOG_CONSOLE_LEVEL=info
# LOG_ENABLE_OTEL=false
# LOG_OTEL_SERVICE_NAME=fastgpt-volume-manager
# LOG_OTEL_URL=http://localhost:4318/v1/logs
# LOG_OTEL_LEVEL=warning
