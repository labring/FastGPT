{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@fastgpt-sdk/storage/access-link": ["../../sdk/storage/src/access-link/index.ts"],
      "@fastgpt-sdk/storage": ["../../sdk/storage/src/index.ts"],
      "@fastgpt-sdk/otel": ["../../sdk/otel/src/index.ts"],
      "@fastgpt-sdk/otel/logger": ["../../sdk/otel/src/logger-entry.ts"],
      "@fastgpt-sdk/otel/metrics": ["../../sdk/otel/src/metrics-entry.ts"],
      "@fastgpt-sdk/otel/tracing": ["../../sdk/otel/src/tracing-entry.ts"],
      "@/*": ["./src/*"],
      "#fastgpt/app/test/*": ["./test/*"],
      "@test/*": ["../../test/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../packages/web/i18n/i18next.ts",
    "../../packages/global/**/*.d.ts",
    "../../packages/service/**/*.d.ts",
    "../../packages/web/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "test/**",
    "scripts/**",
    "worker/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest*.config.ts",
    "../../packages/**/vitest*.config.ts",
    "../../packages/**/tsdown.config.ts",
    "../../packages/**/test/**",
    "../../packages/**/dist/**",
    ".next",
    "dist",
    "coverage"
  ]
}
