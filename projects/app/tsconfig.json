{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "#fastgpt/app/test/*": ["./test/*"],
      "@test/*": ["../../test/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "scripts/reset-root-password.ts",
    "scripts/reset-root-password-utils.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../packages/web/i18n/i18next.ts",
    "../../packages/global/**/*.d.ts",
    "../../packages/service/**/*.d.ts",
    "../../packages/web/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "test/**",
    "scripts/build-*.ts",
    "scripts/migration/**",
    "scripts/permission/**",
    "scripts/dist/**",
    "worker/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest*.config.ts",
    "../../packages/**/vitest*.config.ts",
    "../../packages/**/tsdown.config.ts",
    "../../packages/**/test/**",
    "../../packages/**/dist/**",
    "../../packages/**/.tsc-out/**",
    ".next",
    "dist",
    "coverage",
    ".tsc-out"
  ]
}
