# =====================================================================
# FastGPT 环境变量样本（实例配置中心重构后）
#
# 本文件只保留必须由「进程启动环境」注入的变量：
#   - 基础设施连接（MongoDB / Redis / 向量库 / 对象存储）
#   - 安全根与跨进程信任密钥
#   - 部署拓扑、域名与构建期配置
#   - 独立子服务的连接地址与凭据
#   - 进程观测（日志 / 指标 / 链路追踪）
#
# 站点信息、功能开关、账号与登录、安全策略、资源限制、性能与并发、
# 文件与存储策略、向量索引参数、外部提供商、Agent Sandbox 运行配置等
# 已迁入后台实例配置中心，由管理员在 /admin 在线维护，持久化于 MongoDB
# 集合 system_instance_configs，不再通过环境变量配置。
#
# 迁移期说明：
#   1. 首次初始化会用下列变量作为 seed 来源，写入 system_instance_configs
#      （projects/app/src/migration/tasks/20260928_migrate_instance_configs）。
#   2. 库中已有值时以库为准，环境变量不再覆盖；库中缺失时回退到环境变量，
#      最后回退到代码内置默认值（见 .agents/design/common/
#      admin-instance-config-env-boundary.md §10.6）。
#   3. 当前运行时尚未切换到读取实例配置（仍经 serviceEnv / appEnv 读环境变量），
#      因此本文件删除的变量在切换完成前若被显式设置，仍会生效；切换完成后将
#      仅作为 seed 来源，不再影响运行时。
# =====================================================================

# ==================== 基础与进程 ====================
# 默认用户密码（用户名为 root），每次重启会自动更新。
DEFAULT_ROOT_PSW=123456
# 数据库最大连接数
DB_MAX_LINK=20
# 自动同步索引
SYNC_INDEX=true
# 系统迁移任务每批处理的记录数，范围 50～1000，默认 100
SYSTEM_MIGRATION_BATCH_SIZE=100
# 配置了 delay 的系统迁移任务延迟执行时间（秒），默认 0 为不延迟
SYSTEM_MIGRATION_DELAY_SECONDS=0

# ==================== 密钥 ====================
# 文件阅读时的密钥
FILE_TOKEN_KEY=
# 密钥加密 key
AES256_SECRET_KEY=fastgptsecret
# Invoke 反向调用 JWT 密钥，至少 32 位
INVOKE_TOKEN_SECRET=fastgpt_invoke_token_secret_32_chars_min
# root key（最高权限）
ROOT_KEY=fdafasd

# ==================== 商业版服务 ====================
# 商业版地址；配置后即启用商业版界面与能力
# PRO_URL=
# PRO_TOKEN=

# ==================== 独立子服务连接（部署拓扑） ====================
# 子服务在 Docker Compose / K8s 中按服务名互联，连接地址与凭据统一由 ENV 注入，
# 避免在前台重复输入导致启动死锁；/admin/subservice/* 页面只做状态监控与连通性探测。
# 插件服务
PLUGIN_BASE_URL=http://localhost:3004
PLUGIN_TOKEN=XHgR8zvKx1FhjHUxCKdJMNpzFUMlavM1

# 代码沙箱服务
CODE_SANDBOX_URL=http://localhost:3002
CODE_SANDBOX_TOKEN=codesandbox

# AI Proxy API
AIPROXY_API_ENDPOINT=http://localhost:3010
AIPROXY_API_TOKEN=token

# MCP Server 代理地址，用于 MCP 使用方式页拼接 SSE 地址（末尾不要带 /）
SSE_MCP_SERVER_PROXY_ENDPOINT=http://localhost:3003

# ==================== 沙盒代理（agent-sandbox-proxy） ====================
# 代理链路属于部署拓扑，保留 ENV；Agent Sandbox 的 Provider 切换与资源规格
# 在 /admin/subservice/agent-sandbox 页面维护。
# JWT 验签与内网安全物理阻断密钥（必须与 Rust Proxy 的同名变量完全一致，生产环境请配置为至少 32 字节的高强度随机值）
AGENT_SANDBOX_PROXY_SECRET=default_fastgpt_agent_sandbox_proxy_secret
# 浏览器客户端连接沙盒代理的对外 WebSocket 地址。
# 启用 Agent Sandbox 时必填；未启用时可留空。
# 开发环境建议配置为 ws://localhost:3006（指向 Docker Compose 中的 Rust 代理）；
# 生产环境请配置浏览器可访问的 ws:// 或 wss:// 代理地址。
AGENT_SANDBOX_PROXY_URL=ws://localhost:3006
# 浏览器访问沙盒文件预览的 HTTP(S) 地址。启用 Agent Sandbox 时必填；默认单端口部署时与 WebSocket 使用相同端口。
AGENT_SANDBOX_PREVIEW_PROXY_URL=http://localhost:3006

# ==================== 对象存储 ====================
# 存储供应商；如果是 Sealos 的对象存储请填 aws-s3
STORAGE_VENDOR=minio
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_PUBLIC_BUCKET=fastgpt-public
STORAGE_PRIVATE_BUCKET=fastgpt-private
# 客户端可直连的对象存储地址；仅作为首次部署的初值，之后以管理界面「存储外部访问端点」为准
STORAGE_EXTERNAL_ENDPOINT=
# short-redirect 临时下载地址使用的 CDN 地址；仅作为首次部署的初值，之后以管理界面配置为准
STORAGE_S3_CDN_ENDPOINT=
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_MAX_RETRIES=3
STORAGE_PUBLIC_ACCESS_EXTRA_SUB_PATH=
# 以下为可选的对象存储厂商专属参数（按需配置）
# STORAGE_R2_PUBLIC_ENDPOINT=
# STORAGE_COS_PROTOCOL=https:
# STORAGE_COS_USE_ACCELERATE=false
# STORAGE_COS_CNAME_DOMAIN=
# STORAGE_COS_PROXY=
# STORAGE_OSS_ENDPOINT=
# STORAGE_OSS_CNAME=false
# STORAGE_OSS_INTERNAL=false
# STORAGE_OSS_SECURE=false
# STORAGE_OSS_ENABLE_PROXY=true

# ==================== 过渡期变量（待运行时初始化接入后移除） ====================
# 以下三项已迁入实例配置（/admin 系统概览页），但当前仍被 next.config.ts 在
# 构建期读取并内联进客户端产物，用于首屏 title / favicon。在「运行时初始化
# 配置」接入之前不能移除，否则首屏会退回代码默认值。
# 运行时接入后，请删除本节并改为在后台维护。
SYSTEM_NAME=FastGPT
SYSTEM_DESCRIPTION=
SYSTEM_FAVICON=

# ==================== 数据库与缓存 ====================
# Redis URL
REDIS_URL=redis://default:mypassword@localhost:6379

# MongoDB 连接参数；本地开发连接远程数据库时，可能需要添加 directConnection=true 才能连接
MONGODB_URI=mongodb://myusername:mypassword@localhost:27017/fastgpt?authSource=admin&directConnection=true
# 日志库
MONGODB_LOG_URI=

# ==================== 向量库 ====================
# 向量库优先级: pg > oceanbase > milvus > opengauss
# PG 向量库连接参数
PG_URL=postgresql://username:password@localhost:5432/postgres
# OceanBase 向量库连接参数
# OCEANBASE_URL=
# SeekDB 向量库连接参数
# SEEKDB_URL=
# Milvus 向量库连接参数(使用 Milvus 时,全文检索自动启用 BM25;版本需 >= 2.5,推荐 2.5.16+)
# MILVUS_ADDRESS=
# MILVUS_TOKEN=
# openGauss 向量库连接参数
# OPENGAUSS_URL=postgresql://gaussdb:FastGPT@123@localhost:5432/fastgpt

# 向量量化等级: PG 支持 32/16，OceanBase 支持 32/8/1
VECTOR_VQ_LEVEL=32
# Milvus BM25 语言识别引擎: lingua(默认) | whatlang
# MILVUS_LANGUAGE_IDENTIFIER=lingua

# ==================== 外部数据源与动作（可选） ====================
# 官网访客归因 CRM（地址未配置时不进行身份上报）
# CRM_API_URL=https://crm.example.com/api/v1
# CRM_API_KEY=
# 第三方数据源默认地址（不配置时使用官方默认值）
# FEISHU_BASE_URL=https://open.feishu.cn
# DINGTALK_BASE_URL=https://api.dingtalk.com
# DINGTALK_OAPI_BASE_URL=https://oapi.dingtalk.com
# YUQUE_DATASET_BASE_URL=https://www.yuque.com
# 智能分块服务（文本→chunk）。配置后集合可选「智能分块」导入模式；未配置时该选项不可用，
# 不影响平台其他分块功能。地址格式非法会在启动时报错。
# SANGFOR_CHUNK_URL=
# SANGFOR_CHUNK_KEY=
# SANGFOR_CHUNK_TIMEOUT_MINUTES=60

# ==================== 对话日志推送（可选） ====================
# 日志服务地址
# CHAT_LOG_URL=http://localhost:8080
# 日志推送间隔（毫秒）
# CHAT_LOG_INTERVAL=10000
# 日志来源 ID 前缀
# CHAT_LOG_SOURCE_ID_PREFIX=fastgpt-

# ==================== 域名与前端 ====================
# 必填。客户端访问 FastGPT 时使用的地址，由协议、主机和可选端口组成，用于补全相对路径资源（注意结尾不要带 /）
FE_DOMAIN=http://localhost:3000
# 文件域名（也指向 FastGPT 服务）；如需更高安全性可独立分配域名，避免高危文件读取到主域名内容
FILE_DOMAIN=http://localhost:3000
# 下载短链公开 URL 前缀。配置后下载链接生成为 {prefix}/{signedAlias}，通常由 nginx rewrite 到 FastGPT /api/system/file/d/{signedAlias}；仅影响下载，不影响上传
# FILE_DOWNLOAD_PUBLIC_URL_PREFIX=
# 二级路由，需要在打包时确定
# NEXT_PUBLIC_BASE_URL=/fastai

# 中国大陆访问自动重定向地址，留空表示不跳转
CHINESE_IP_REDIRECT_URL=
# 自定义 API 域名与分享页域名（部署绑定，需 DNS / 证书配合）
CUSTOM_API_DOMAIN=
CUSTOM_SHARE_PAGE_DOMAIN=
# 全站注入脚本（JSON 数组）
# SCRIPTS=

# ==================== 安全（部署边界） ====================
# 是否为登录 Cookie 添加 Secure 属性，仅在全站 HTTPS 时启用
AUTH_COOKIE_SECURE=false
# 是否启用可信反向代理客户端 IP 校验
TRUSTED_PROXY_ENABLE=false
# 可信反向代理 IP/CIDR 列表，逗号或空白分隔。仅 TRUSTED_PROXY_ENABLE=true 时生效；仅显式可信代理传入的 X-Forwarded-For/X-Real-IP 会用于客户端 IP 解析
TRUSTED_PROXY_IPS=

# ==================== 日志配置 ====================
# 日志等级: trace | debug | info | warning | error | fatal
LOG_ENABLE_CONSOLE=true
LOG_CONSOLE_LEVEL=debug
LOG_ENABLE_OTEL=true
LOG_OTEL_LEVEL=info
LOG_OTEL_SERVICE_NAME=fastgpt-client
LOG_OTEL_URL=http://localhost:4318/v1/logs

# 指标
METRICS_ENABLE_OTEL=true
METRICS_EXPORT_INTERVAL=30000
METRICS_OTEL_URL=http://localhost:4318/v1/metrics
METRICS_OTEL_SERVICE_NAME=fastgpt-client

# 追踪
TRACING_ENABLE_OTEL=true
TRACING_OTEL_URL=http://localhost:4318/v1/traces
TRACING_OTEL_SERVICE_NAME=fastgpt-client
TRACING_OTEL_SAMPLE_RATIO=1

# Langfuse（需同时开启 TRACING_ENABLE_OTEL）
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ==================== 进程级网络代理 ====================
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
# ALL_PROXY=
